{
  "appId": "com.wepi.logistic",
  "appName": "Wepi Logistic",
  "webDir": "dist",
  "plugins": {
    "CapacitorUpdater": {
      "appId": "com.wepi.logistic",
      "autoUpdate": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#c62828"
    },
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#ffffffff",
      "showSpinner": true
    }
  }
}
